# Copy to .env for local reference ONLY. Never commit the real .env file.
# On Vercel, set these in Project -> Settings -> Environment Variables.

# Token from @BotFather (format: 123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Random string, 1-256 chars, only A-Z a-z 0-9 _ -
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The SAME value must be passed as secret_token when calling setWebhook.
TELEGRAM_WEBHOOK_SECRET=your-random-secret-here
